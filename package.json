{
  "name": "hayaraku-react-app",
  "version": "1.0.0",
  "main": "build/electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:build:dev": "npm run build && npx tsc -p electron",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && tsc -p electron -w\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && tsc -p electron && electron-builder build --win --x64 -c electron-builder.js --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
